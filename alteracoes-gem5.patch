diff --git a/workloads/p02/teste_monitor.cc b/workloads/p02/teste_monitor.cc
new file mode 100644
index 0000000000..cda6cd23f7
--- /dev/null
+++ b/workloads/p02/teste_monitor.cc
@@ -0,0 +1,54 @@
+#include <pthread.h>
+#include <string>
+#include <thread>
+
+#include <gem5/m5ops.h>
+#include <gem5/p02_barrier_events.h>
+
+pthread_barrier_t barrier;
+bool useBarrier = false;
+
+void participant(unsigned tid)
+{
+    if (tid == 1) {
+        for (volatile unsigned i = 0; i < 100000; i++) {
+        }
+    }
+
+    for (unsigned i = 0; i < 10; i++) {
+        m5_barrier(1, P02_ARRIVE);
+
+        if (useBarrier) {
+            pthread_barrier_wait(&barrier);
+        }
+
+        m5_barrier(1, P02_DEPART);
+    }
+}
+
+int main(int argc, char *argv[])
+{
+    if (argc == 2 && std::string(argv[1]) == "--com-barreira") {
+        useBarrier = true;
+    }
+
+    if (useBarrier) {
+        int result = pthread_barrier_init(&barrier, nullptr, 2);
+
+        if (result != 0) {
+            return 1;
+        }
+    }
+
+    std::thread worker(participant, 1);
+
+    participant(0);
+
+    worker.join();
+
+    if (useBarrier) {
+        pthread_barrier_destroy(&barrier);
+    }
+
+    return 0;
+}
