+++ b/configs/projetos/p02/campanha_p02.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Executa a matriz mínima do Projeto 2 e registra cada comando em JSONL."""
+import argparse
+import itertools
+import json
+import subprocess
+from pathlib import Path
+
+
+def combinations():
+    for algorithm, threads, perturb in itertools.product(("central", "dissem"), (1, 2, 4, 8, 16), (1, 2, 3)):
+        for work, imbalance in itertools.product((0, 1000, 10000), (0.0, 0.5)):
+            yield "micro", algorithm, threads, work, imbalance, perturb, "timing"
+        for size in (128, 512):
+            yield "jacobi", algorithm, threads, size, 0.0, perturb, "timing"
+        yield "integ", algorithm, threads, 10000, 0.0, perturb, "timing"
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("gem5", type=Path)
+    parser.add_argument("--out", type=Path, default=Path("m5out/p02"))
+    parser.add_argument("--limiar", type=int, default=8)
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+    script = Path(__file__).with_name("sistema_p02.py")
+    args.out.mkdir(parents=True, exist_ok=True)
+    log = args.out / "commands.jsonl"
+    with log.open("w") as output:
+        for index, (program, algorithm, threads, work, imbalance, perturb, cpu) in enumerate(combinations()):
+            run = args.out / f"{index:03d}-{program}-{algorithm}-p{threads}-w{work}-s{perturb}"
+            command = [str(args.gem5), "-d", str(run), str(script), "--threads", str(threads),
+                       "--alg", algorithm, "--limiar", str(args.limiar), "--prog", program,
+                       "--work", str(work), "--imbalance", str(imbalance), "--iters", "100",
+                       "--perturb", str(perturb), "--cpu", cpu]
+            output.write(json.dumps({"dir": str(run), "command": command}) + "\n")
+            output.flush()
+            if not args.dry_run:
+                subprocess.run(command, check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/configs/projetos/p02/extrai_p02.py b/configs/projetos/p02/extrai_p02.py
new file mode 100644
index 0000000000..001847783b
--- /dev/null
+++ b/configs/projetos/p02/extrai_p02.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+"""Lê a região medida e confere os contadores do monitor."""
+import argparse
+import configparser
+import csv
+import math
+import shlex
+from pathlib import Path
+
+
+def read_stats(path):
+    stats = {}
+    reading = False
+    for line in path.read_text(errors="replace").splitlines():
+        if "Begin Simulation Statistics" in line:
+            if reading:
+                raise ValueError("Bloco de estatísticas incompleto.")
+            reading = True
+        elif "End Simulation Statistics" in line and reading:
+            # Primeiro dump: região medida. O dump final inclui o encerramento.
+            return stats
+        elif reading:
+            parts = line.split()
+            if len(parts) >= 2 and not line.lstrip().startswith("#"):
+                try:
+                    stats[parts[0]] = float(parts[1])
+                except ValueError:
+                    raise ValueError(f"Estatística inválida: {line}")
+    raise ValueError("Nenhum bloco completo de estatísticas.")
+
+
+def read_options(path):
+    config = configparser.ConfigParser(interpolation=None)
+    config.read(path, encoding="utf-8")
+    for section in config.sections():
+        if config[section].get("type") == "Process":
+            command = shlex.split(config[section]["cmd"])
+            options = dict(zip(command[1::2], command[2::2]))
+            options["program"] = Path(command[0]).name
+            return options
+    raise ValueError("Processo não encontrado no config.ini.")
+
+
+def extract(path):
+    stats = read_stats(path)
+    options = read_options(path.parent / "config.ini")
+    program = options["program"]
+    if program not in ("micro", "jacobi", "integ"):
+        raise ValueError("Esta extração espera micro, jacobi ou integ com eventos.")
+
+    threads = int(options["--threads"])
+    iters = int(options["--iters"])
+    if threads <= 0 or iters <= 0:
+        raise ValueError("Threads e iterações devem ser positivas.")
+    expected = iters * 2 if program == "integ" else iters
+    monitor = "system.barrier_monitor."
+
+    episodes = stats[monitor + "barriersCompleted::1"]
+    early = stats[monitor + "earlyDepartures"]
+    invalid = stats[monitor + "invalidEvents"]
+    arrivals = [stats[monitor + f"arrivals::{tid}"] for tid in range(threads)]
+    release_samples = stats[monitor + "releaseLatency::samples"]
+    wait_samples = stats[monitor + "waitDist::samples"]
+
+    errors = []
+    if early != 0 or invalid != 0:
+        errors.append("Monitor detectou erros")
+    if episodes != expected:
+        errors.append("Quantidade de episódios incorreta")
+    if any(count != expected for count in arrivals):
+        errors.append("Quantidade de chegadas incorreta")
+    if release_samples != expected or wait_samples != threads * expected:
+        errors.append("Quantidade de amostras incorreta")
+    if stats["simTicks"] <= 0 or not math.isfinite(stats["simTicks"]):
+        errors.append("Tempo inválido")
+
+    row = {
+        "program": program, "threads": threads, "iters": iters,
+        "algorithm": options["--alg"], "work": options["--work"],
+        "imbalance": options["--imbalance"], "perturb": options["--perturb"],
+        "monitor_ok": int(not errors), "error": "; ".join(errors),
+        "sim_ticks": stats["simTicks"], "ticks_per_iteration": stats["simTicks"] / iters,
+        "episodes": episodes, "arrivals_per_thread": ";".join(str(int(n)) for n in arrivals),
+        "early_departures": early, "invalid_events": invalid,
+        "wait_mean": stats[monitor + "waitDist::mean"],
+        "arrival_spread_mean": stats[monitor + "arrivalSpread::mean"],
+        "release_latency_mean": stats[monitor + "releaseLatency::mean"],
+    }
+    wait = sum(stats[monitor + f"waitTicks::{tid}"] for tid in range(threads))
+    row["wait_fraction"] = wait / (threads * stats["simTicks"]) if not errors else ""
+
+    # Usa somente os totais, sem somá-los novamente com os requisitantes.
+    for level in ("l1d", "l2"):
+        caches = [f"system.cpu{tid}.dcache." for tid in range(threads)] if level == "l1d" else ["system.l2."]
+        for metric in ("lockedRMWs::total", "amoOps::total", "snoopInvalidations", "demandMisses::total"):
+            count = 0
+            for cache in caches:
+                if cache + "snoopInvalidations" not in stats:
+                    raise ValueError(f"Cache ou contadores ausentes: {cache}")
+                # Vetores com nozero podem omitir totais iguais a zero.
+                count += stats.get(cache + metric, 0)
+            row[level + "_" + metric.split("::")[0] + "_per_episode"] = count / expected
+    return row
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("root", type=Path)
+    parser.add_argument("--csv", type=Path, default=Path("p02.csv"))
+    args = parser.parse_args()
+    paths = [args.root / "stats.txt"] if (args.root / "stats.txt").is_file() else sorted(args.root.glob("*/stats.txt"))
+    if not paths:
+        parser.error("Nenhum stats.txt encontrado.")
+    rows = []
+    for path in paths:
+        row = {"run": path.parent.name}
+        try:
+            row.update(extract(path))
+        except (OSError, ValueError, KeyError, configparser.Error) as error:
+            row.update(monitor_ok=0, error=str(error))
+        rows.append(row)
+    columns = list(dict.fromkeys(key for row in rows for key in row))
+    with args.csv.open("w", newline="", encoding="utf-8") as output:
+        writer = csv.DictWriter(output, fieldnames=columns)
+        writer.writeheader()
+        writer.writerows(rows)
+    print(f"CSV salvo em {args.csv}")
+    if any(not row["monitor_ok"] for row in rows):
+        raise SystemExit("Há execuções com erro; consulte o CSV.")
+
+
+if __name__ == "__main__":
+    main()
