index 0000000000..3bd372abaf
--- /dev/null
+++ b/configs/projetos/p02/sistema_p02.py
@@ -0,0 +1,152 @@
+import argparse
+from pathlib import Path
+
+import m5
+from m5.objects import *
+
+
+parser = argparse.ArgumentParser()
+
+parser.add_argument("--threads", type=int, default=4)
+
+parser.add_argument(
+    "--alg",
+    choices=["central", "dissem", "auto"],
+    default="central",
+)
+
+parser.add_argument("--limiar", type=int, default=8)
+
+parser.add_argument(
+    "--prog",
+    choices=["micro", "jacobi", "integ"],
+    default="micro",
+)
+
+parser.add_argument("--work", type=int, default=0)
+parser.add_argument("--imbalance", type=float, default=0.0)
+parser.add_argument("--iters", type=int, default=100)
+parser.add_argument("--perturb", type=int, default=0)
+
+parser.add_argument(
+    "--cpu",
+    choices=["timing", "o3"],
+    default="timing",
+)
+
+parser.add_argument("--no-monitor", action="store_true")
+
+args = parser.parse_args()
+
+if args.threads <= 0 or args.iters <= 0:
+    parser.error("Threads e iterações devem ser maiores que zero.")
+
+if args.work < 0 or args.imbalance < 0 or args.perturb < 0:
+    parser.error("Trabalho, desequilíbrio e semente não podem ser negativos.")
+
+if args.alg == "auto" and args.limiar <= 0:
+    parser.error("O limiar deve ser maior que zero para usar auto.")
+
+root_dir = Path(__file__).resolve().parents[3]
+binary = root_dir / "workloads/p02" / args.prog
+
+if not binary.is_file():
+    parser.error(f"Programa não encontrado: {binary}. Compile o workload primeiro.")
+
+
+# Parâmetros das caches baseados em configs/learning_gem5/part1/caches.py.
+class L1Cache(Cache):
+    assoc = 2
+    tag_latency = 2
+    data_latency = 2
+    response_latency = 2
+    mshrs = 4
+    tgts_per_mshr = 20
+
+
+class L2Cache(Cache):
+    size = "256KiB"
+    assoc = 8
+    tag_latency = 20
+    data_latency = 20
+    response_latency = 20
+    mshrs = 20
+    tgts_per_mshr = 12
+
+
+system = System()
+system.clk_domain = SrcClockDomain(
+    clock="2GHz",
+    voltage_domain=VoltageDomain(),
+)
+system.mem_mode = "timing"
+system.mem_ranges = [AddrRange("512MiB")]
+system.cache_line_size = 64
+
+system.membus = SystemXBar()
+system.l2bus = L2XBar()
+system.system_port = system.membus.cpu_side_ports
+
+system.l2 = L2Cache()
+system.l2.cpu_side = system.l2bus.mem_side_ports
+system.l2.mem_side = system.membus.cpu_side_ports
+
+if args.cpu == "timing":
+    system.cpu = [TimingSimpleCPU(cpu_id=i) for i in range(args.threads)]
+else:
+    system.cpu = [DerivO3CPU(cpu_id=i) for i in range(args.threads)]
+
+for cpu in system.cpu:
+    cpu.icache = L1Cache(size="16KiB", is_read_only=True)
+    cpu.dcache = L1Cache(size="64KiB")
+
+    cpu.icache_port = cpu.icache.cpu_side
+    cpu.dcache_port = cpu.dcache.cpu_side
+    cpu.icache.mem_side = system.l2bus.cpu_side_ports
+    cpu.dcache.mem_side = system.l2bus.cpu_side_ports
+
+    cpu.mmu.connectWalkerPorts(
+        system.l2bus.cpu_side_ports,
+        system.l2bus.cpu_side_ports,
+    )
+
+    cpu.createInterruptController()
+    cpu.interrupts[0].pio = system.membus.mem_side_ports
+    cpu.interrupts[0].int_requestor = system.membus.cpu_side_ports
+    cpu.interrupts[0].int_responder = system.membus.mem_side_ports
+
+system.mem_ctrl = MemCtrl()
+system.mem_ctrl.dram = DDR3_1600_8x8()
+system.mem_ctrl.dram.range = system.mem_ranges[0]
+system.mem_ctrl.port = system.membus.mem_side_ports
+
+if not args.no_monitor:
+    system.barrier_monitor = BarrierMonitor(
+        participants=args.threads,
+        cpus=system.cpu,
+        hist_max=1_000_000,
+        hist_buckets=100,
+    )
+
+system.workload = SEWorkload.init_compatible(str(binary))
+
+process = Process()
+process.cmd = [
+    str(binary),
+    "--threads", str(args.threads),
+    "--alg", args.alg,
+    "--limiar", str(args.limiar),
+    "--work", str(args.work),
+    "--imbalance", str(args.imbalance),
+    "--iters", str(args.iters),
+    "--perturb", str(args.perturb),
+]
+
+for cpu in system.cpu:
+    cpu.workload = process
+    cpu.createThreads()
+
+root = Root(full_system=False, system=system)
+m5.instantiate()
+event = m5.simulate()
+print(f"Fim no tick {m5.curTick()}: {event.getCause()}")
