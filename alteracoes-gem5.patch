diff --git a/workloads/p02/integ.cc b/workloads/p02/integ.cc
new file mode 100644
index 0000000000..16a50f38df
--- /dev/null
+++ b/workloads/p02/integ.cc
@@ -0,0 +1,220 @@
+#include <cstdint>
+#include <functional>
+#include <iomanip>
+#include <iostream>
+#include <random>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+#include "central.h"
+
+struct Params
+{
+    unsigned threads = 4;
+    unsigned iters = 100;
+    unsigned work = 10000;
+    unsigned threshold = 8;
+    unsigned seed = 0;
+    unsigned warmup = 10;
+    Algorithm algorithm = Algorithm::Central;
+};
+
+double workIntegrer(unsigned tid, const Params &params, double parameter)
+{
+    // Cada thread integra pela regra do ponto médio.
+    uint64_t n = params.work;
+    uint64_t first = n * tid / params.threads;
+    uint64_t end = (n * tid + n) / params.threads;
+    double width = 1.0 / n;
+    double sum = 0.0;
+
+    for (uint64_t i = first; i < end; i++) {
+        double x = (i + 0.5) * width;
+        sum += parameter * x * x * width;
+    }
+    return sum;
+}
+
+void participant(
+    unsigned tid,
+    const Params &params,
+    Barrier &measured,
+    Barrier &control,
+    std::vector<double> &partial,
+    double &parameter,
+    double &result
+){
+    std::mt19937 generator(params.seed + tid);
+    unsigned delay = generator() % 300;
+    for (volatile unsigned i = 0; i < delay; i++) { }
+
+    for (unsigned i = 0; i < params.warmup; i++) {
+        // Calcula as parciais (retangulos)
+        partial[tid] = workIntegrer(tid, params, parameter);
+        measured.wait(tid);
+
+        if (tid == 0) {
+            result = 0.0;
+            for (double value : partial) {
+                result += value;
+            }
+            // Muda o parâmetro para os novos parciais
+            parameter = 1.0 + result;
+        }
+        measured.wait(tid);
+    }
+
+    control.wait(tid);
+
+    if (tid == 0) {
+        parameter = 1.0;
+    }
+
+    #ifdef USE_M5OPS
+        if (tid == 0) {
+            m5_reset_stats(0, 0);
+        }
+    #endif
+
+    control.wait(tid);
+
+    for (unsigned iteration = 0; iteration < params.iters; iteration++) {
+        // Calcula as parciais (retangulos)
+        partial[tid] = workIntegrer(tid, params, parameter);
+        measured.wait(tid);
+
+        if (tid == 0) {
+            result = 0.0;
+            for (double value : partial) {
+                result += value;
+            }
+            // Muda o parâmetro para os novos parciais
+            parameter = 1.0 + result;
+        }
+        measured.wait(tid);
+    }
+
+    control.wait(tid);
+
+    #ifdef USE_M5OPS
+        if (tid == 0) {
+            m5_dump_stats(0, 0);
+        }
+    #endif
+}
+
+int main(int argc, char *argv[])
+{
+    Params params;
+
+    // Lê as opções do terminal.
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
+            std::cout
+                << "Opções: --threads N --iters N --work N "
+                << "--alg central|dissem|auto --limiar N "
+                << "--imbalance F --perturb N\n";
+            return 0;
+        }
+
+        if (i + 1 >= argc) {
+            std::cerr << "Falta o valor de " << option << "\n";
+            return 1;
+        }
+
+        std::string text = argv[i + 1];
+
+        if (option == "--alg") {
+            if (text == "central") {
+                params.algorithm = Algorithm::Central;
+            } else if (text == "dissem") {
+                params.algorithm = Algorithm::Dissem;
+            } else if (text == "auto") {
+                params.algorithm = Algorithm::Auto;
+            } else {
+                std::cerr << "Algoritmo inválido: " << text << "\n";
+                return 1;
+            }
+
+            continue;
+        }
+
+        if (text.empty() || text[0] == '-') {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+
+        std::istringstream value(text);
+
+        if (option == "--threads") {
+            value >> params.threads;
+        } else if (option == "--iters") {
+            value >> params.iters;
+        } else if (option == "--work") {
+            value >> params.work;
+        } else if (option == "--limiar") {
+            value >> params.threshold;
+        } else if (option == "--imbalance") {
+            double imbalance;
+            value >> imbalance;
+        } else if (option == "--perturb") {
+            value >> params.seed;
+        } else {
+            std::cerr << "Opção desconhecida: " << option << "\n";
+            return 1;
+        }
+
+        if (value.fail() || !value.eof()) {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+    }
+
+    // Confere os parâmetros.
+    if (params.threads == 0 || params.iters == 0) {
+        std::cerr << "Threads e iterações devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    if (params.work == 0) {
+        std::cerr << "Informe pelo menos um subintervalo.\n";
+        return 1;
+    }
+
+    if (params.algorithm == Algorithm::Auto && params.threshold == 0) {
+        std::cerr << "Informe --limiar maior que zero para usar auto.\n";
+        return 1;
+    }
+
+    auto measured = createBarrier(params.algorithm, params.threads, 1, params.threshold);
+    CentralBarrier control(params.threads, P02_BARRIER_CTRL);
+    std::vector<double> partial(params.threads);
+    double parameter = 1.0;
+    double result = 0.0;
+    std::vector<std::thread> threads;
+
+    for (unsigned tid = 1; tid < params.threads; tid++) {
+        threads.emplace_back(
+            participant,
+            tid,
+            std::cref(params),
+            std::ref(*measured),
+            std::ref(control),
+            std::ref(partial),
+            std::ref(parameter),
+            std::ref(result)
+        );
+    }
+
+    participant(0, params, *measured, control, partial, parameter, result);
+    for (auto &thread : threads) {
+        thread.join();
+    }
+
+    std::cout << std::setprecision(17) << "Resultado: " << result << "\n";
+    std::cout << "Episódios medidos: " << 2ULL * params.iters << "\n";
+    return 0;
+}
diff --git a/workloads/p02/jacobi.cc b/workloads/p02/jacobi.cc
new file mode 100644
index 0000000000..e25b1af52c
--- /dev/null
+++ b/workloads/p02/jacobi.cc
@@ -0,0 +1,284 @@
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+#include <sstream>
+#include <random>
+
+#include "barreira.h"
+#include "central.h"
+
+struct Params {
+    unsigned threads = 4;
+    unsigned iters = 20;
+    unsigned warmup = 10;
+    unsigned size = 128;
+    unsigned threshold = 8;
+    unsigned seed = 0;
+    unsigned offset = 0;
+
+    Algorithm algorithm = Algorithm::Central;
+};
+
+void workJacobi(
+    unsigned tid,
+    const Params &params,
+    const std::vector<std::vector<uint64_t>> &current,
+    std::vector<std::vector<uint64_t>> &next
+)
+{
+    unsigned interiorRows = params.size - 2;
+    unsigned firstRow = 1 + interiorRows * tid / params.threads;
+    unsigned lastRow = 1 + interiorRows * (tid + 1) / params.threads;
+
+    // Cada thread calcula suas linhas.
+    for (unsigned row = firstRow; row < lastRow; row++) {
+        for (unsigned column = 1; column < params.size - 1; column++) {
+            unsigned col = column + params.offset;
+
+            uint64_t top = current[row - 1][col];
+            uint64_t bottom = current[row + 1][col];
+            uint64_t left = current[row][col - 1];
+            uint64_t right = current[row][col + 1];
+
+            next[row][col] = (top + bottom + left + right) / 4;
+        }
+    }
+}
+
+void participant(
+    unsigned tid,
+    const Params &params,
+    Barrier &measured,
+    Barrier &control,
+    std::vector<std::vector<uint64_t>> &gridA,
+    std::vector<std::vector<uint64_t>> &gridB
+)
+{
+    std::mt19937 delayGenerator(params.seed + tid);
+    unsigned delay = delayGenerator() % 300;
+
+    for (volatile unsigned i = 0; i < delay; i++) {}
+
+    // Cada thread tem seus ponteiros
+    std::vector<std::vector<uint64_t>> *current = &gridA;
+    std::vector<std::vector<uint64_t>> *next = &gridB;
+
+    // Aquecimento
+    for (unsigned i = 0; i < params.warmup; i++) {
+        workJacobi(tid, params, *current, *next);
+        measured.wait(tid);
+        std::swap(current, next);
+    }
+
+    control.wait(tid);
+
+    if (tid == 0) {
+        // As bordas continuam em 100; apenas o interior foi alterado.
+        for (unsigned row = 1; row < params.size - 1; row++) {
+            for (unsigned column = 1; column < params.size - 1; column++) {
+                gridA[row][column + params.offset] = 1;
+                gridB[row][column + params.offset] = 1;
+            }
+        }
+
+        #ifdef USE_M5OPS
+                m5_reset_stats(0, 0);
+        #endif
+    }
+
+    // A medição sempre começa lendo A e escrevendo B.
+    current = &gridA;
+    next = &gridB;
+
+    // Espera a restauração das matrizes e o reset das estatísticas.
+    control.wait(tid);
+
+    for (unsigned iteration = 0; iteration < params.iters; iteration++) {
+        workJacobi(tid, params, *current, *next);
+        // Todos precisam terminar antes da próxima iteração.
+        measured.wait(tid);
+        std::swap(current, next);
+    }
+
+    control.wait(tid);
+
+    #ifdef USE_M5OPS
+        if (tid == 0) {
+            m5_dump_stats(0, 0);
+        }
+    #endif
+}
+
+
+int main(int argc, char *argv[])
+{
+    Params params;
+
+    // Lê as opções do terminal.
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
+            std::cout
+                << "Opções: --threads N --iters N --work N "
+                << "--alg central|dissem|auto --limiar N "
+                << "--imbalance F --perturb N\n";
+            return 0;
+        }
+
+        if (i + 1 >= argc) {
+            std::cerr << "Falta o valor de " << option << "\n";
+            return 1;
+        }
+
+        std::string text = argv[i + 1];
+
+        if (option == "--alg") {
+            if (text == "central") {
+                params.algorithm = Algorithm::Central;
+            } else if (text == "dissem") {
+                params.algorithm = Algorithm::Dissem;
+            } else if (text == "auto") {
+                params.algorithm = Algorithm::Auto;
+            } else {
+                std::cerr << "Algoritmo inválido: " << text << "\n";
+                return 1;
+            }
+
+            continue;
+        }
+
+        if (text.empty() || text[0] == '-') {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+
+        std::istringstream value(text);
+
+        if (option == "--threads") {
+            value >> params.threads;
+        } else if (option == "--iters") {
+            value >> params.iters;
+        } else if (option == "--work") {
+            value >> params.size;
+        } else if (option == "--limiar") {
+            value >> params.threshold;
+        } else if (option == "--imbalance") {
+            double imbalance;
+            value >> imbalance;
+        } else if (option == "--perturb") {
+            value >> params.seed;
+        } else {
+            std::cerr << "Opção desconhecida: " << option << "\n";
+            return 1;
+        }
+
+        if (value.fail() || !value.eof()) {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+    }
+
+    // Confere os parâmetros.
+    if (params.threads == 0 || params.iters == 0) {
+        std::cerr << "Threads e iterações devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    if (params.size < 3) {
+        std::cerr << "O tamanho da matriz deve ser pelo menos 3.\n";
+        return 1;
+    }
+
+    if (params.algorithm == Algorithm::Auto && params.threshold == 0) {
+        std::cerr << "Informe --limiar maior que zero.\n";
+        return 1;
+    }
+
+    std::mt19937 generator(params.seed);
+    params.offset = generator() % 8;
+
+    // Cria a primeira matriz preenchida com 1.
+    std::vector<std::vector<uint64_t>> gridA(
+        params.size,
+        std::vector<uint64_t>(params.size + params.offset, 1)
+    );
+
+    // Define as bordas com 100.
+    for (unsigned i = 0; i < params.size; i++) {
+        gridA[0][i + params.offset] = 100;
+        gridA[params.size - 1][i + params.offset] = 100;
+
+        gridA[i][params.offset] = 100;
+        gridA[i][params.offset + params.size - 1] = 100;
+    }
+
+    // Cria a segunda matriz com os mesmos valores
+    std::vector<std::vector<uint64_t>> gridB = gridA;
+
+    // Cria a barreira que será medida.
+    std::unique_ptr<Barrier> measured = createBarrier(
+        params.algorithm,
+        params.threads,
+        1,
+        params.threshold
+    );
+
+    if (!measured) {
+        std::cerr << "Não foi possível criar a barreira.\n";
+        return 1;
+    }
+
+    // Cria a barreira de controle da região de interesse.
+    CentralBarrier control(params.threads, P02_BARRIER_CTRL);
+
+    // Inicia as threads adicionais.
+    std::vector<std::thread> threads;
+
+    for (unsigned tid = 1; tid < params.threads; tid++) {
+        threads.emplace_back(
+            participant,
+            tid,
+            std::cref(params),
+            std::ref(*measured),
+            std::ref(control),
+            std::ref(gridA),
+            std::ref(gridB)
+        );
+    }
+
+    // A thread principal também calcula.
+    participant(0, params, *measured, control, gridA, gridB);
+
+    // Espera todas terminarem.
+    for (std::thread &thread : threads) {
+        thread.join();
+    }
+
+    const std::vector<std::vector<uint64_t>> *finalGrid;
+
+    if (params.iters % 2 == 0) {
+        finalGrid = &gridA;
+    } else {
+        finalGrid = &gridB;
+    }
+
+    // Soma os pontos da matriz final.
+    uint64_t total = 0;
+
+    for (unsigned row = 0; row < params.size; row++) {
+        for (unsigned column = 0; column < params.size; column++) {
+            total += (*finalGrid)[row][column + params.offset];
+        }
+    }
+
+    std::cout << "Threads: " << params.threads << "\n";
+    std::cout << "Iterações medidas: " << params.iters << "\n";
+    std::cout << "Episódios medidos: " << params.iters << "\n";
+    std::cout << "Resultado: " << total << "\n";
+
+    return 0;
+}
