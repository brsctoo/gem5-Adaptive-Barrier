index 0000000000..bcf68ee259
--- /dev/null
+++ b/configs/barreira/teste_m5_barreira.py
@@ -0,0 +1,79 @@
+from pathlib import Path
+
+import m5
+from m5.objects import (
+    AddrRange,
+    DDR3_1600_8x8,
+    MemCtrl,
+    Process,
+    Root,
+    SEWorkload,
+    SrcClockDomain,
+    System,
+    SystemXBar,
+    TimingSimpleCPU,
+    VoltageDomain,
+)
+
+system.barrier_monitor = BarrierMonitor(
+    participants=1,
+    cpus=[system.cpu],
+)
+
+# Localiza o executável a partir da localização deste script.
+raiz = Path(__file__).resolve().parents[2]
+binario = raiz / "workloads/p02/teste_m5_barrier"
+
+system = System()
+
+# Clock da máquina simulada.
+system.clk_domain = SrcClockDomain()
+system.clk_domain.clock = "2GHz"
+system.clk_domain.voltage_domain = VoltageDomain()
+
+# Memória e modelo de execução.
+system.mem_mode = "timing"
+system.mem_ranges = [AddrRange("512MiB")]
+
+# Uma CPU, suficiente para testar as duas chamadas.
+system.cpu = TimingSimpleCPU()
+system.cpu.createInterruptController()
+
+# Barramento que conecta CPU e memória.
+system.membus = SystemXBar()
+system.cpu.icache_port = system.membus.cpu_side_ports
+system.cpu.dcache_port = system.membus.cpu_side_ports
+
+# Conexões de interrupção necessárias para x86.
+system.cpu.interrupts[0].pio = system.membus.mem_side_ports
+system.cpu.interrupts[0].int_requestor = system.membus.cpu_side_ports
+system.cpu.interrupts[0].int_responder = system.membus.mem_side_ports
+
+# Controlador e memória DDR3.
+system.mem_ctrl = MemCtrl()
+system.mem_ctrl.dram = DDR3_1600_8x8()
+system.mem_ctrl.dram.range = system.mem_ranges[0]
+system.mem_ctrl.port = system.membus.mem_side_ports
+
+system.system_port = system.membus.cpu_side_ports
+
+# Programa executado em modo SE.
+system.workload = SEWorkload.init_compatible(str(binario))
+
+process = Process()
+process.cmd = [str(binario)]
+
+system.cpu.workload = process
+system.cpu.createThreads()
+
+root = Root(full_system=False, system=system)
+
+m5.instantiate()
+
+print("Iniciando teste de m5_barrier...")
+
+# Limite para evitar que um problema deixe o teste rodando indefinidamente.
+evento = m5.simulate(100_000_000_000)
+
+print(f"Simulação encerrada no tick {m5.curTick()}.")
+print(f"Motivo: {evento.getCause()}")
