+        }
+    }
+
+    if (threads == 0 || iters == 0) {
+        std::cerr << "Threads e iterações devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    uint64_t total = 0;
+    uint64_t totalIterations = uint64_t(warmup) + iters;
+
+    // Faz o trabalho de cada thread, uma de cada vez.
+    for (unsigned tid = 0; tid < threads; tid++) {
+        std::mt19937 generator(seed + tid);
+        std::uniform_real_distribution<double> distribution(0.0, 1.0);
+
+        for (uint64_t iteration = 0;
+             iteration < totalIterations;
+             iteration++) {
+
+            uint64_t n = work;
+
+            if (imbalance > 0 && n > 0) {
