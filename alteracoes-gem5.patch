+/* Etapa 05 */
+
+#include "dissem.h"
+
+DisseminationBarrier::DisseminationBarrier(unsigned numParticipants, uint64_t id)
+    : Barrier(numParticipants, id),
+      rounds(0),
+      threads(numParticipants)
+{
+    uint64_t distance = 1;
+
+    while (distance < numParticipants) {
+        rounds++;
+        distance *= 2;
+    }
+
+    for (unsigned tid = 0; tid < numParticipants; tid++) {
+        threads[tid].flags[0] = std::make_unique<Flag[]>(rounds);
+        threads[tid].flags[1] = std::make_unique<Flag[]>(rounds);
+
+        threads[tid].partners[0].resize(rounds);
+        threads[tid].partners[1].resize(rounds);
+    }
+
+    for (unsigned tid = 0; tid < numParticipants; tid++) {
+        distance = 1;
+
+        for (unsigned round = 0; round < rounds; round++) {
+            unsigned partner = (tid + distance) % numParticipants;
+
+            threads[tid].partners[0][round] = &threads[partner].flags[0][round];
+            threads[tid].partners[1][round] = &threads[partner].flags[1][round];
+
+            distance *= 2;
+        }
+    }
+}
+
+void DisseminationBarrier::waitImpl(unsigned tid)
+{
+    ThreadData &data = threads[tid];
+    unsigned parity = data.parity;
+
+    for (unsigned round = 0; round < rounds; round++) {
+        Flag *destination = data.partners[parity][round];
+        Flag &local = data.flags[parity][round];
+
+        (*destination).value.store(data.sense, std::memory_order_release);
+
+        while (local.value.load(std::memory_order_acquire) != data.sense) { }
+    }
+
+    if (parity == 1) {
+        data.sense = 1 - data.sense;
+    }
+
+    data.parity = 1 - parity;
+}
