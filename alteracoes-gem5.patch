+/* Etapa 04 */
+
+#pragma once
+#include "barreira.h"
+
+class CentralBarrier : public Barrier
+{
+  public:
+    CentralBarrier(unsigned numParticipants, uint64_t id);
+
+  protected:
+    void waitImpl(unsigned tid) override
+    {
+        // Inverte o sentido
+        localSense[tid].value = 1 - localSense[tid].value;
+
+        // Decrementa o contador
+        unsigned previous = counter.fetch_sub(
+            1, std::memory_order_acq_rel
+        );
+
+        if (previous == 1) {
+            // Restaura o contador
+            counter.store(numParticipants, std::memory_order_relaxed);
+            sense.store(localSense[tid].value, std::memory_order_release);
+        } else {
+            // Espera até observar o sentido deste episódio.
+            while (sense.load(std::memory_order_acquire) != localSense[tid].value) { }
+        }
+    }
+
+  private:
+    alignas(CACHE_LINE) std::atomic<unsigned> counter;
+    alignas(CACHE_LINE) std::atomic<unsigned> sense;
+
+    struct alignas(CACHE_LINE) ThreadSense
+    {
+        unsigned value = 0;
+    };
+
+    std::unique_ptr<ThreadSense[]> localSense;
+};
diff --git a/workloads/p02/dissem.cc b/workloads/p02/dissem.cc
