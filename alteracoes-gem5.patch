+/* Etapa 05 */
+
+#pragma once
+#include <vector>
+#include "barreira.h"
+
+class DisseminationBarrier : public Barrier
+{
+  public:
+    DisseminationBarrier(unsigned numParticipants, uint64_t id);
+
+  protected:
+    void waitImpl(unsigned tid) override;
+
+  private:
+    struct alignas(CACHE_LINE) Flag
+    {
+        std::atomic<unsigned> value{0};
+    };
+
+    struct alignas(CACHE_LINE) ThreadData
+    {
+        std::unique_ptr<Flag[]> flags[2];
+        std::vector<Flag *> partners[2];
+
+        unsigned parity = 0;
+        unsigned sense = 1;
+    };
+
+    unsigned rounds;
+    std::vector<ThreadData> threads;
+};
diff --git a/workloads/p02/micro.cc b/workloads/p02/micro.cc
new file mode 100644
index 0000000000..5f1f39a8bc
--- /dev/null
+++ b/workloads/p02/micro.cc
@@ -0,0 +1,218 @@
+/* Listagem 11.13 */
+/* 11.9 */
+
+#include <cstdint>
+#include <iostream>
+#include <random>
+#include <thread>
+#include <vector>
+#include <functional>
+#include <sstream>
+#include <string>
+#include "central.h"
+
+struct Params
+{
+    unsigned numThreads = 4;
+    unsigned iterations = 100;
+    unsigned warmup = 10;
+
+    uint64_t work = 1000;
+    double imbalance = 0.0;
+    uint64_t seed = 1;
+    Algorithm algorithm = Algorithm::Central;
+    unsigned threshold = 0;
+};
+
+uint64_t
+syntheticWork(
+    unsigned tid,
+    const Params &params,
+    std::mt19937 &generator
+)
+{
+    uint64_t n = params.work;
+
+    if (params.imbalance > 0 && n > 0) {
+        std::uniform_real_distribution<double> distribution(0.0, 1.0);
+        double u = distribution(generator);
+        n += static_cast<uint64_t>(n * params.imbalance * u);
+    }
+
+    uint64_t acc = tid + 1;
+
+    for (uint64_t k = 0; k < n; k++) {
+        acc = acc * 3 + k;
+    }
+
+    return acc;
+}
+
+void participant(
+    unsigned tid,
+    const Params &params,
+    Barrier &measured,
+    Barrier &control,
+    uint64_t &result
+)
+{
+    std::mt19937 generator(params.seed + tid);
+    uint64_t total = 0;
+
+    // Aquecimento
+    for (unsigned i = 0; i < params.warmup; i++) {
+        total += syntheticWork(tid, params, generator);
+        measured.wait(tid);
+    }
+
+    control.wait(tid);
+
+#ifdef USE_M5OPS
+    if (tid == 0) {
+        m5_reset_stats(0, 0);
+    }
+#endif
+
+    control.wait(tid);
+
+    // Região de interesse.
+    for (unsigned i = 0; i < params.iterations; i++) {
+        total += syntheticWork(tid, params, generator);
+        measured.wait(tid);
+    }
+
+    control.wait(tid);
+
+#ifdef USE_M5OPS
+    if (tid == 0) {
+        m5_dump_stats(0, 0);
+    }
+#endif
+
+    result = total;
+}
+
+int main(int argc, char *argv[])
+{
+    Params params;
+
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
+            std::cout
+                << "Opções: --threads N --iters N --work N "
+                << "--imbalance F --perturb N "
+                << "--alg central|dissem|auto --limiar N\n";
+            return 0;
+        }
+
+        if (i + 1 >= argc) {
+            std::cerr << "Falta o valor de " << option << "\n";
+            return 1;
+        }
+
+        std::string text = argv[i + 1];
+
+        if (option == "--alg") {
+            if (text == "central") {
+                params.algorithm = Algorithm::Central;
+            } else if (text == "dissem") {
+                params.algorithm = Algorithm::Dissem;
+            } else if (text == "auto") {
+                params.algorithm = Algorithm::Auto;
+            } else {
+                std::cerr << "Algoritmo inválido: " << text << "\n";
+                return 1;
+            }
+
+            continue;
+        }
+
+        std::istringstream value(text);
+
+        if (text.empty() || text[0] == '-') {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+
+        if (option == "--threads") {
+            value >> params.numThreads;
+        } else if (option == "--iters") {
+            value >> params.iterations;
+        } else if (option == "--work") {
+            value >> params.work;
+        } else if (option == "--imbalance") {
+            value >> params.imbalance;
+        } else if (option == "--perturb") {
+            value >> params.seed;
+        } else if (option == "--limiar") {
+            value >> params.threshold;
+        } else {
+            std::cerr << "Opção desconhecida: " << option << "\n";
+            return 1;
+        }
+
+        if (value.fail() || !value.eof()) {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+    }
+
+    if (params.numThreads == 0 || params.iterations == 0) {
+        std::cerr << "Threads e iterações devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    if (params.algorithm == Algorithm::Auto && params.threshold == 0) {
+        std::cerr << "Informe --limiar maior que zero para usar auto.\n";
+        return 1;
+    }
+
+    std::unique_ptr<Barrier> measured = createBarrier(
+        params.algorithm,
+        params.numThreads,
+        1,
+        params.threshold
+    );
+
+    if (!measured) {
+        std::cerr << "Não foi possível criar a barreira.\n";
+        return 1;
+    }
+
+    CentralBarrier control(params.numThreads, P02_BARRIER_CTRL);
+
+    std::vector<uint64_t> results(params.numThreads, 0);
+    std::vector<std::thread> threads;
+
+    for (unsigned tid = 1; tid < params.numThreads; tid++) {
+        threads.emplace_back(
+            participant,
+            tid,
+            std::cref(params),
+            std::ref(*measured),
+            std::ref(control),
+            std::ref(results[tid])
+        );
+    }
+
+    participant(0, params, *measured, control, results[0]);
+
+    for (std::thread &thread : threads) {
+        thread.join();
+    }
+
+    uint64_t total = 0;
+
+    for (unsigned tid = 0; tid < params.numThreads; tid++) {
+        total += results[tid];
+    }
+
+    std::cout << "Threads: " << params.numThreads << "\n";
+    std::cout << "Iterações medidas: " << params.iterations << "\n";
+    std::cout << "Episódios medidos: " << params.iterations << "\n";
+    std::cout << "Resultado: " << total << "\n";
+
+    return 0;
+}
