@@ -0,0 +1,98 @@
+#include <cstdint>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+int main(int argc, char *argv[])
+{
+    unsigned threads = 4;
+    unsigned iters = 100;
+    unsigned work = 10000;
+
+    // Lê os argumentos.
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
+            std::cout << "Opções: --threads N --iters N --work N\n";
+            return 0;
+        }
+
+        if (i + 1 >= argc) {
+            std::cerr << "Falta o valor de " << option << "\n";
+            return 1;
+        }
+
+        std::string text = argv[i + 1];
+
+        if (text.empty() || text[0] == '-') {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+
+        std::istringstream value(text);
+
+        if (option == "--threads") {
+            value >> threads;
+        } else if (option == "--iters") {
+            value >> iters;
+        } else if (option == "--work") {
+            value >> work;
+        } else {
+            std::cerr << "Opção desconhecida: " << option << "\n";
+            return 1;
+        }
+
+        if (value.fail() || !value.eof()) {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+    }
+
+    if (threads == 0 || iters == 0 || work == 0) {
+        std::cerr
+            << "Threads, iterações e trabalho devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    std::vector<double> partial(threads);
+
+    uint64_t n = work;
+    double width = 1.0 / n;
+    double parameter = 1.0;
+    double result = 0.0;
+
+    for (unsigned iteration = 0; iteration < iters; iteration++) {
+
+        // Calcula cada parcial, uma de cada vez.
+        for (unsigned tid = 0; tid < threads; tid++) {
+            uint64_t first = n * tid / threads;
+            uint64_t end = (n * tid + n) / threads;
+            double sum = 0.0;
+
+            for (uint64_t i = first; i < end; i++) {
+                double x = (i + 0.5) * width;
+                sum += parameter * x * x * width;
+            }
+
+            partial[tid] = sum;
+        }
+
+        // Combina as parciais na mesma ordem do paralelo.
+        result = 0.0;
+
+        for (unsigned tid = 0; tid < threads; tid++) {
+            result += partial[tid];
+        }
+
+        parameter = 1.0 + result;
+    }
+
+    std::cout
+        << std::setprecision(17)
+        << "Resultado: " << result << "\n";
+
+    return 0;
+}
diff --git a/workloads/p02/sequential/jacobi_seq.cc b/workloads/p02/sequential/jacobi_seq.cc
