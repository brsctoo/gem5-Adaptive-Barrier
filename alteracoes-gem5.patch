--- /dev/null
+++ b/workloads/p02/barreira.cc
@@ -0,0 +1,30 @@
+#include "barreira.h"
+#include "central.h"
+#include "dissem.h"
+
+std::unique_ptr<Barrier>
+createBarrier(
+    Algorithm algorithm,
+    unsigned numParticipants,
+    uint64_t id,
+    unsigned threshold
+)
+{
+    if (algorithm == Algorithm::Auto) {
+        if (numParticipants >= threshold) {
+            algorithm = Algorithm::Dissem;
+        } else {
+            algorithm = Algorithm::Central;
+        }
+    }
+
+    if (algorithm == Algorithm::Central) {
+        return std::make_unique<CentralBarrier>(numParticipants, id);
+    }
+
+    if (algorithm == Algorithm::Dissem) {
+        return std::make_unique<DisseminationBarrier>(numParticipants, id);
+    }
+
+    return nullptr;
+}
