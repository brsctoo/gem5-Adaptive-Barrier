+/* Etapa 02 */
+
+#ifndef GEM5_BARRIER_MONITOR_HH
+#define GEM5_BARRIER_MONITOR_HH
+
+#include <array>
+#include <vector>
+
+#include "base/statistics.hh"
+#include "base/types.hh"
+#include "params/BarrierMonitor.hh"
+#include "sim/sim_object.hh"
+
+namespace gem5
+{
+
+    class BarrierMonitor : public SimObject
+    {
+      public:
+        PARAMS(BarrierMonitor);
+
+        BarrierMonitor(const Params &params);
+        ~BarrierMonitor() override;
+
+        static BarrierMonitor *instance()
+        {
+            return _instance;
+        }
+
+        void event(ContextID ctx, Tick when, uint64_t id, uint64_t fase);
+
+        void startup() override;
+
+      private:
+        static BarrierMonitor *_instance;
+
+        const unsigned numParticipants;
+
+        struct Episode
+        {
+            bool inUse = false;
+            uint64_t number = 0;
+
+            unsigned arrived = 0;
+            unsigned departed = 0;
+
+            Tick firstArrival = 0;
+            Tick lastArrival = 0;
+        };
+
+        std::vector<std::array<Episode, 2>> episodes;
+
+        struct CtxBarrier
+        {
+            uint64_t arrivals = 0;
+            uint64_t departures = 0;
+
+            Tick arriveTick = 0;
+        };
+
+        std::vector<std::vector<CtxBarrier>> ctxs;
+
+        void arrive(ContextID ctx, Tick when, unsigned id);
+        void depart(ContextID ctx, Tick when, unsigned id);
+
+        struct MonitorStats : public statistics::Group
+        {
+            MonitorStats(BarrierMonitor *parent, unsigned n, unsigned b);
+
+            statistics::Vector barriersCompleted;
+            statistics::Vector arrivals;
+            statistics::Vector waitTicks;
+
+            statistics::Distribution waitDist;
+            statistics::Distribution arrivalSpread;
+            statistics::Distribution releaseLatency;
+
+            statistics::Scalar earlyDepartures;
+            statistics::Scalar invalidEvents;
+
+            statistics::Formula meanWait;
+        };
+
+        MonitorStats stats;
+    };
+}
+
+#endif
