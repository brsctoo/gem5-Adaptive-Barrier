+++ b/workloads/p02/sequential/jacobi_seq.cc
@@ -0,0 +1,105 @@
+#include <cstdint>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+int main(int argc, char *argv[])
+{
+    unsigned size = 128;
+    unsigned iters = 20;
+
+    // Lê os argumentos.
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
+            std::cout << "Opções: --work N --iters N\n";
+            return 0;
+        }
+
+        if (i + 1 >= argc) {
+            std::cerr << "Falta o valor de " << option << "\n";
+            return 1;
+        }
+
+        std::string text = argv[i + 1];
+
+        if (text.empty() || text[0] == '-') {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+
+        std::istringstream value(text);
+
+        if (option == "--work") {
+            value >> size;
+        } else if (option == "--iters") {
+            value >> iters;
+        } else {
+            std::cerr << "Opção desconhecida: " << option << "\n";
+            return 1;
+        }
+
+        if (value.fail() || !value.eof()) {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+    }
+
+    if (size < 3 || iters == 0) {
+        std::cerr
+            << "O tamanho deve ser pelo menos 3 "
+            << "e as iterações devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    // Cria a primeira matriz.
+    std::vector<std::vector<uint64_t>> current(
+        size,
+        std::vector<uint64_t>(size, 1)
+    );
+
+    // Define as bordas fixas.
+    for (unsigned i = 0; i < size; i++) {
+        current[0][i] = 100;
+        current[size - 1][i] = 100;
+        current[i][0] = 100;
+        current[i][size - 1] = 100;
+    }
+
+    // A segunda matriz começa igual à primeira.
+    std::vector<std::vector<uint64_t>> next = current;
+
+    // Executa as iterações.
+    for (unsigned iteration = 0; iteration < iters; iteration++) {
+        for (unsigned row = 1; row < size - 1; row++) {
+            for (unsigned column = 1; column < size - 1; column++) {
+                uint64_t top = current[row - 1][column];
+                uint64_t bottom = current[row + 1][column];
+                uint64_t left = current[row][column - 1];
+                uint64_t right = current[row][column + 1];
+
+                next[row][column] =
+                    (top + bottom + left + right) / 4;
+            }
+        }
+
+        std::swap(current, next);
+    }
+
+    // Soma os pontos da matriz final.
+    uint64_t total = 0;
+
+    for (unsigned row = 0; row < size; row++) {
+        for (unsigned column = 0; column < size; column++) {
+            total += current[row][column];
+        }
+    }
+
+    std::cout << "Iterações: " << iters << "\n";
+    std::cout << "Resultado: " << total << "\n";
+
+    return 0;
+}
