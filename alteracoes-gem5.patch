@@ -0,0 +1,220 @@
+/* Etapa 02 */
+
+#include "projetos/p02/barrier_monitor.hh"
+#include "base/logging.hh"
+#include "cpu/base.hh"
+#include "cpu/thread_context.hh"
+#include <gem5/p02_barrier_events.h>
+
+namespace gem5
+{
+    BarrierMonitor *BarrierMonitor::_instance = nullptr;
+
+    BarrierMonitor::BarrierMonitor(const Params &params)
+        : SimObject(params),
+          numParticipants(params.participants),
+          stats(this, params.participants, params.max_barriers)
+    {
+        fatal_if(_instance != nullptr, "Já existe um BarrierMonitor.");
+
+        fatal_if(numParticipants == 0, "O número de participantes deve ser maior que zero.");
+
+        fatal_if(params.max_barriers == 0, "O número de barreiras deve ser maior que zero.");
+
+        episodes.resize(params.max_barriers);
+
+        ctxs.resize(numParticipants);
+
+        for (unsigned i = 0; i < numParticipants; i++) {
+            ctxs[i].resize(params.max_barriers);
+        }
+
+        _instance = this;
+    }
+
+    BarrierMonitor::~BarrierMonitor()
+    {
+        _instance = nullptr;
+    }
+
+    BarrierMonitor::MonitorStats::MonitorStats(
+        BarrierMonitor *monitor,
+        unsigned numContexts,
+        unsigned numBarriers
+    )
+        : statistics::Group(monitor),
+
+        ADD_STAT(barriersCompleted, statistics::units::Count::get(), "Barreiras concluídas"),
+        ADD_STAT(arrivals, statistics::units::Count::get(), "Chegadas por contexto"),
+        ADD_STAT(waitTicks, statistics::units::Tick::get(), "Tempo total de espera por contexto"),
+        ADD_STAT(waitDist, statistics::units::Tick::get(), "Tempos de espera"),
+        ADD_STAT(arrivalSpread, statistics::units::Tick::get(), "Dispersão das chegadas"),
+        ADD_STAT(releaseLatency, statistics::units::Tick::get(), "Latência de liberação"),
+        ADD_STAT(earlyDepartures, statistics::units::Count::get(), "Saídas antecipadas"),
+        ADD_STAT(invalidEvents, statistics::units::Count::get(), "Eventos inválidos"),
+        ADD_STAT(meanWait, statistics::units::Tick::get(), "Espera média")
+    {
+        barriersCompleted.init(numBarriers);
+        arrivals.init(numContexts);
+        waitTicks.init(numContexts);
+
+        Tick histMax = (*monitor).params().hist_max;
+        unsigned histBuckets = (*monitor).params().hist_buckets;
+
+        fatal_if(histMax == 0 || histBuckets == 0, "O limite e o número de faixas devem ser maiores que zero.");
+
+        Tick bucketSize = histMax / histBuckets;
+
+        if (histMax % histBuckets != 0) {
+            bucketSize++;
+        }
+
+        waitDist.init(0, histMax, bucketSize);
+        arrivalSpread.init(0, histMax, bucketSize);
+        releaseLatency.init(0, histMax, bucketSize);
+
+        meanWait = statistics::sum(waitTicks) / statistics::sum(arrivals);
+    }
+
+    void BarrierMonitor::startup()
+    {
+        SimObject::startup();
+
+        const Params &config  = (*this).params();
+
+        if (config.cpus.size() != numParticipants) {
+            fatal("A quantidade de CPUs deve ser igual a de participantes.");
+        }
+
+        for (int i = 0; i < numParticipants; i++) {
+            BaseCPU *cpu = config.cpus[i];
+
+            if (cpu == nullptr) {
+                fatal("Uma CPU da lista nao foi definida.");
+            }
+
+            if ((*cpu).numContexts() != 1) {
+                fatal("Cada CPU deve ter exatamente um contexto.");
+            }
+
+            ThreadContext *context = (*cpu).getContext(0);
+
+            if ((*context).contextId() != i) {
+                fatal("O identificador do contexto nao corresponde a ordem das CPUs.");
+            }
+        }
+    }
+
+    void BarrierMonitor::event(
+        ContextID ctx,
+        Tick when,
+        uint64_t id,
+        uint64_t phase
+    )
+    {
+        if (ctx >= ctxs.size()) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        if (id >= episodes.size()) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        if (phase == P02_ARRIVE) {
+            arrive(ctx, when, id);
+        } else if (phase == P02_DEPART) {
+            depart(ctx, when, id);
+        } else {
+            stats.invalidEvents++;
+        }
+    }
+
+    void BarrierMonitor::arrive(ContextID ctx, Tick when, unsigned id)
+    {
+        CtxBarrier &context = ctxs[ctx][id];
+
+        if (context.arrivals != context.departures) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        uint64_t episodeNumber = context.arrivals;
+
+        Episode &episode = episodes[id][episodeNumber % 2];
+
+        if (episode.inUse && episode.number != episodeNumber) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        if (!episode.inUse) {
+            episode = Episode{};
+            episode.inUse = true;
+            episode.number = episodeNumber;
+            episode.firstArrival = when;
+        }
+
+        episode.arrived++;
+        episode.lastArrival = when;
+
+        context.arriveTick = when;
+        context.arrivals++;
+
+        if (id != P02_BARRIER_CTRL) {
+            stats.arrivals[ctx]++;
+        }
+    }
+
+    void BarrierMonitor::depart(ContextID ctx, Tick when, unsigned id)
+    {
+        CtxBarrier &context = ctxs[ctx][id];
+
+        if (context.arrivals <= context.departures) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        uint64_t episodeNumber = context.departures;
+        Episode &episode = episodes[id][episodeNumber % 2];
+
+        if (!episode.inUse || episode.number != episodeNumber) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        if (when < context.arriveTick) {
+            stats.invalidEvents++;
+            return;
+        }
+
+        if (episode.arrived < numParticipants) {
+            stats.earlyDepartures++;
+        }
+
+        Tick wait = when - context.arriveTick;
+
+        if (id != P02_BARRIER_CTRL) {
+            stats.waitTicks[ctx] += wait;
+            stats.waitDist.sample(wait);
+        }
+
+        context.departures++;
+        episode.departed++;
+
+        if (episode.departed == numParticipants) {
+            stats.barriersCompleted[id]++;
+
+            if (id != P02_BARRIER_CTRL) {
+                Tick spread = episode.lastArrival - episode.firstArrival;
+                Tick release = when - episode.lastArrival;
+
+                stats.arrivalSpread.sample(spread);
+                stats.releaseLatency.sample(release);
+            }
+
+            episode.inUse = false;
+        }
+    }
+}
