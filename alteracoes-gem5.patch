+/* Etapa 04 */
+
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+#include <gem5/p02_barrier_events.h>
+
+#ifdef USE_M5OPS
+#include <gem5/m5ops.h>
+#define P02_EVENT(id, phase) m5_barrier((id), (phase))
+#else
+#define P02_EVENT(id, phase) ((void)0)
+#endif
+
+constexpr std::size_t CACHE_LINE = 64;
+
+enum class Algorithm
+{
+    Central,
+    Dissem,
+    Auto
+};
+
+class Barrier
+{
+  public:
+    Barrier(unsigned numParticipants, uint64_t id)
+        : numParticipants(numParticipants), id(id)
+    {
+    }
+
+    virtual ~Barrier() = default;
+
+    void wait(unsigned tid)
+    {
+        P02_EVENT(id, P02_ARRIVE);
+
+        waitImpl(tid);
+
+        P02_EVENT(id, P02_DEPART);
+    }
+
+  protected:
+    virtual void waitImpl(unsigned tid) = 0;
+
+    const unsigned numParticipants;
+    const uint64_t id;
+};
+
+std::unique_ptr<Barrier> createBarrier(
+    Algorithm algorithm,
+    unsigned numParticipants,
+    uint64_t id,
+    unsigned threshold
+);
