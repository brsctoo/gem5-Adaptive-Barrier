+
+int main(int argc, char *argv[])
+{
+    unsigned threads = 4;
+    unsigned iters = 100;
+    unsigned warmup = 10;
+
+    uint64_t work = 1000;
+    double imbalance = 0.0;
+    uint64_t seed = 1;
+
+    // Lê os argumentos.
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
