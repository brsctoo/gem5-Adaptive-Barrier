+#!/usr/bin/env python3
+"""Executa a matriz mínima do Projeto 2 e registra cada comando em JSONL."""
+import argparse
+import itertools
+import json
+import subprocess
+from pathlib import Path
+
+
+def combinations():
+    for algorithm, threads, perturb in itertools.product(("central", "dissem"), (1, 2, 4, 8, 16), (1, 2, 3)):
+        for work, imbalance in itertools.product((0, 1000, 10000), (0.0, 0.5)):
+            yield "micro", algorithm, threads, work, imbalance, perturb, "timing"
+        for size in (128, 512):
+            yield "jacobi", algorithm, threads, size, 0.0, perturb, "timing"
+        yield "integ", algorithm, threads, 10000, 0.0, perturb, "timing"
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("gem5", type=Path)
+    parser.add_argument("--out", type=Path, default=Path("m5out/p02"))
+    parser.add_argument("--limiar", type=int, default=8)
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+    script = Path(__file__).with_name("sistema_p02.py")
+    args.out.mkdir(parents=True, exist_ok=True)
+    log = args.out / "commands.jsonl"
+    with log.open("w") as output:
+        for index, (program, algorithm, threads, work, imbalance, perturb, cpu) in enumerate(combinations()):
+            run = args.out / f"{index:03d}-{program}-{algorithm}-p{threads}-w{work}-s{perturb}"
+            command = [str(args.gem5), "-d", str(run), str(script), "--threads", str(threads),
+                       "--alg", algorithm, "--limiar", str(args.limiar), "--prog", program,
+                       "--work", str(work), "--imbalance", str(imbalance), "--iters", "100",
+                       "--perturb", str(perturb), "--cpu", cpu]
+            output.write(json.dumps({"dir": str(run), "command": command}) + "\n")
+            output.flush()
+            if not args.dry_run:
+                subprocess.run(command, check=True)
+
+
+if __name__ == "__main__":
+    main()
