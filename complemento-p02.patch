@@ -0,0 +1,76 @@
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "barreira.h"
+#include "central.h"
+
+struct Params {
+    unsigned threads = 4, iters = 20, size = 128, threshold = 8;
+    Algorithm algorithm = Algorithm::Central;
+};
+
+static bool parse(Params &p, int argc, char **argv)
+{
+    for (int i = 1; i < argc; i += 2) {
+        if (i + 1 == argc) return false;
+        std::string key(argv[i]), value(argv[i + 1]);
+        if (key == "--threads") p.threads = std::stoul(value);
+        else if (key == "--iters") p.iters = std::stoul(value);
+        else if (key == "--work") p.size = std::stoul(value);
+        else if (key == "--limiar") p.threshold = std::stoul(value);
+        else if (key == "--alg") {
+            p.algorithm = value == "central" ? Algorithm::Central :
+                          value == "dissem" ? Algorithm::Dissem : Algorithm::Auto;
+        } else if (key != "--imbalance" && key != "--perturb") return false;
+    }
+    return p.threads && p.iters && p.size >= 3 &&
+           (p.algorithm != Algorithm::Auto || p.threshold);
+}
+
+int main(int argc, char **argv)
+{
+    Params p;
+    if (!parse(p, argc, argv)) return 1;
+    const size_t cells = size_t(p.size) * p.size;
+    std::vector<uint64_t> a(cells, 1), b(cells, 0);
+    for (unsigned x = 0; x < p.size; ++x)
+        a[x] = a[cells - p.size + x] = a[size_t(x) * p.size] = a[size_t(x + 1) * p.size - 1] = 100;
+
+    auto measured = createBarrier(p.algorithm, p.threads, 1, p.threshold);
+    CentralBarrier control(p.threads, P02_BARRIER_CTRL);
+    auto worker = [&](unsigned tid) {
+        auto *current = &a;
+        auto *next = &b;
+        const unsigned first = 1 + (p.size - 2) * tid / p.threads;
+        const unsigned last = 1 + (p.size - 2) * (tid + 1) / p.threads;
+        control.wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_reset_stats(0, 0);
+#endif
+        control.wait(tid);
+        for (unsigned it = 0; it < p.iters; ++it) {
+            for (unsigned y = first; y < last; ++y)
+                for (unsigned x = 1; x + 1 < p.size; ++x)
+                    (*next)[size_t(y) * p.size + x] = ((*current)[size_t(y - 1) * p.size + x] +
+                        (*current)[size_t(y + 1) * p.size + x] + (*current)[size_t(y) * p.size + x - 1] +
+                        (*current)[size_t(y) * p.size + x + 1]) / 4;
+            measured->wait(tid);
+            std::swap(current, next);
+        }
+        control.wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_dump_stats(0, 0);
+#endif
+    };
+    std::vector<std::thread> workers;
+    for (unsigned tid = 1; tid < p.threads; ++tid) workers.emplace_back(worker, tid);
+    worker(0);
+    for (auto &thread : workers) thread.join();
+    uint64_t checksum = 0;
+    for (uint64_t value : (p.iters % 2 ? b : a)) checksum += value;
+    std::cout << "Resultado: " << checksum << "\nEpisódios medidos: " << p.iters << "\n";
+}
