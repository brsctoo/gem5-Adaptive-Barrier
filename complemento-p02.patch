@@ -0,0 +1,59 @@
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "barreira.h"
+#include "central.h"
+
+struct Params { unsigned threads = 4, iters = 100, work = 10000, threshold = 8; Algorithm algorithm = Algorithm::Central; };
+
+static bool parse(Params &p, int argc, char **argv)
+{
+    for (int i = 1; i < argc; i += 2) {
+        if (i + 1 == argc) return false;
+        std::string key(argv[i]), value(argv[i + 1]);
+        if (key == "--threads") p.threads = std::stoul(value);
+        else if (key == "--iters") p.iters = std::stoul(value);
+        else if (key == "--work") p.work = std::stoul(value);
+        else if (key == "--limiar") p.threshold = std::stoul(value);
+        else if (key == "--alg") p.algorithm = value == "central" ? Algorithm::Central : value == "dissem" ? Algorithm::Dissem : Algorithm::Auto;
+        else if (key != "--imbalance" && key != "--perturb") return false;
+    }
+    return p.threads && p.iters && p.work && (p.algorithm != Algorithm::Auto || p.threshold);
+}
+
+int main(int argc, char **argv)
+{
+    Params p;
+    if (!parse(p, argc, argv)) return 1;
+    auto measured = createBarrier(p.algorithm, p.threads, 1, p.threshold);
+    auto control = std::make_unique<CentralBarrier>(p.threads, P02_BARRIER_CTRL);
+    std::vector<uint64_t> partial(p.threads), result(1);
+    auto worker = [&](unsigned tid) {
+        control->wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_reset_stats(0, 0);
+#endif
+        control->wait(tid);
+        for (unsigned it = 0; it < p.iters; ++it) {
+            uint64_t sum = 0;
+            for (unsigned i = tid; i < p.work; i += p.threads) sum += uint64_t(i) * i + it;
+            partial[tid] = sum;
+            measured->wait(tid);
+            if (tid == 0) for (uint64_t value : partial) result[0] += value;
+            measured->wait(tid);
+        }
+        control->wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_dump_stats(0, 0);
+#endif
+    };
+    std::vector<std::thread> workers;
+    for (unsigned tid = 1; tid < p.threads; ++tid) workers.emplace_back(worker, tid);
+    worker(0);
+    for (auto &thread : workers) thread.join();
+    std::cout << "Resultado: " << result[0] << "\nEpisódios medidos: " << 2 * p.iters << "\n";
+}
diff --git a/workloads/p02/barrier_stress.cc b/workloads/p02/barrier_stress.cc
new file mode 100644
index 000000000..42db37838
--- /dev/null
+++ b/workloads/p02/barrier_stress.cc
@@ -0,0 +1,30 @@
+#include <cassert>
+#include <atomic>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#include "barreira.h"
+
+int main()
+{
+    for (unsigned participants : {1u, 2u, 3u, 5u, 8u}) {
+        for (Algorithm algorithm : {Algorithm::Central, Algorithm::Dissem}) {
+            auto barrier = createBarrier(algorithm, participants, 1, 4);
+            struct alignas(CACHE_LINE) Slot { std::atomic<unsigned> episode{0}; };
+            std::vector<Slot> slots(participants);
+            auto worker = [&](unsigned tid) {
+                for (unsigned episode = 1; episode <= 10000; ++episode) {
+                    slots[tid].episode.store(episode, std::memory_order_relaxed);
+                    barrier->wait(tid);
+                    for (auto &slot : slots)
+                        assert(slot.episode.load(std::memory_order_acquire) >= episode);
+                }
+            };
+            std::vector<std::thread> threads;
+            for (unsigned tid = 1; tid < participants; ++tid) threads.emplace_back(worker, tid);
+            worker(0);
+            for (auto &thread : threads) thread.join();
+        }
+    }
+}
