--- /dev/null
+++ b/workloads/p02/atomic_counter.cc
@@ -0,0 +1,11 @@
+#include <atomic>
+#include <gem5/m5ops.h>
+
+int main()
+{
+    std::atomic<unsigned> value{0};
+    m5_reset_stats(0, 0);
+    for (unsigned i = 0; i < 1000; ++i) value.fetch_add(1, std::memory_order_relaxed);
+    m5_dump_stats(0, 0);
+    return value.load() != 1000;
+}
