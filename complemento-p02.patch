+CPPFLAGS += -I../../include
+CXXFLAGS += -O2 -std=c++17 -pthread -Wall -Wextra
+
+COMMON = barreira.cc central.cc dissem.cc
+PROGRAMS = micro jacobi integ barrier_stress atomic_counter
+
+all: $(PROGRAMS)
+
+micro: micro.cc $(COMMON)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DUSE_M5OPS $^ -o $@ $(LDFLAGS)
+
+jacobi: jacobi.cc $(COMMON)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DUSE_M5OPS $^ -o $@ $(LDFLAGS)
+
+integ: integ.cc $(COMMON)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DUSE_M5OPS $^ -o $@ $(LDFLAGS)
+
+barrier_stress: barrier_stress.cc $(COMMON)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)
+
+atomic_counter: atomic_counter.cc
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DUSE_M5OPS $< -o $@ $(LDFLAGS)
+
+clean:
+	rm -f $(PROGRAMS)
