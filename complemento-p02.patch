@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Extrai métricas e reprova execuções cujo monitor detectou erro."""
+import argparse
+import csv
+import re
+from pathlib import Path
+
+
+VALUE = re.compile(r"^(\S+)\s+([-+0-9.eE]+)")
+
+
+def read_stats(path):
+    stats = {}
+    for line in path.read_text(errors="replace").splitlines():
+        match = VALUE.match(line)
+        if match:
+            stats[match.group(1)] = float(match.group(2))
+    return stats
+
+
+def value(stats, suffix):
+    return sum(number for name, number in stats.items() if name.endswith(suffix))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("root", type=Path)
+    parser.add_argument("--csv", type=Path, default=Path("p02.csv"))
+    args = parser.parse_args()
+    rows = []
+    for path in sorted(args.root.glob("*/stats.txt")):
+        stats = read_stats(path)
+        invalid = value(stats, "invalidEvents")
+        early = value(stats, "earlyDepartures")
+        episodes = value(stats, "barriersCompleted::1")
+        arrivals = value(stats, "arrivals")
+        rows.append({"run": path.parent.name, "valid": int(not invalid and not early and episodes > 0),
+                     "sim_ticks": stats.get("simTicks", 0), "episodes": episodes,
+                     "arrivals": arrivals, "early_departures": early, "invalid_events": invalid,
+                     "locked_rmws": value(stats, "lockedRMWs"),
+                     "snoop_invalidations": value(stats, "snoopInvalidations")})
+    with args.csv.open("w", newline="") as output:
+        writer = csv.DictWriter(output, fieldnames=rows[0].keys() if rows else ["run", "valid"])
+        writer.writeheader()
+        writer.writerows(rows)
+    if any(not row["valid"] for row in rows):
+        raise SystemExit("há execuções inválidas; consulte o CSV")
+
+
+if __name__ == "__main__":
+    main()
